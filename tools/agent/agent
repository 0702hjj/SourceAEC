# agent —— AI_IFC Agent 终端交互入口（一键弹出 opencode 风格交互页）。
#
#   用法：
#     agent               启动 opencode 风格 TUI（textual，自动装依赖；真实 LLM 按本机配置）
#     agent --scripted    scriptedModel 离线模式（拉起 server 时清空 llmAPIKey）
#     agent --replay <f>  离线回放已保存的 SSE 帧流 JSONL（不连 server，对照回归）
#     agent --demo        轻量终端对话（无依赖 ANSI 版）
#     agent --test        跑本工具单测（pytest，同一 venv）
#     agent --install     把本命令软链到 ~/.local/bin/agent（全局可用）
#     agent --help        帮助
#
#   首次运行自动创建 venv（~/.cache/aiifc-agent/venv）并安装 textual + pytest；
#   服务依赖（edit :8100 / cad :8200 / server :8090）由 TUI 自动拉起。
#   SSE 帧流落盘 ~/.cache/aiifc-agent/frames/（env AIIFC_AGENT_FRAMES_DIR 可改）。
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
VENV_DIR="${AI_IFC_AGENT_VENV:-$HOME/.cache/aiifc-agent/venv}"
PYTHON="$VENV_DIR/bin/python"
REPO="$(cd "$SCRIPT_DIR/../.." && pwd)"  # tools/agent → 仓库根（原 ../../.. 多一层错指到父目录）

case "${1:-}" in
  --demo)
    exec python3 "$SCRIPT_DIR/agent_demo.py"
    ;;
  --test)
    if [ ! -x "$PYTHON" ]; then
      echo "[agent] 首次运行：创建 venv（$VENV_DIR）并安装 textual + pytest…"
      python3 -m venv "$VENV_DIR"
      "$VENV_DIR/bin/pip" install --quiet textual pytest
    fi
    shift  # 丢掉 --test，余下参数透传 pytest
    exec "$PYTHON" -m pytest "$SCRIPT_DIR" -q "$@"
    ;;
  --install)
    mkdir -p "$HOME/.local/bin"
    ln -sf "$SCRIPT_DIR/agent" "$HOME/.local/bin/agent"
    echo "[agent] 已软链到 ~/.local/bin/agent（确保 ~/.local/bin 在 PATH）"
    exit 0
    ;;
  --help|-h)
    sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

if [ ! -x "$PYTHON" ]; then
  echo "[agent] 首次运行：创建 venv（$VENV_DIR）并安装 textual…"
  python3 -m venv "$VENV_DIR"
  "$VENV_DIR/bin/pip" install --quiet textual pytest
  echo "[agent] venv 就绪"
fi

if ! "$PYTHON" -c "import textual" >/dev/null 2>&1; then
  echo "[agent] textual 缺失，安装…"
  "$VENV_DIR/bin/pip" install --quiet textual
fi

exec "$PYTHON" "$SCRIPT_DIR/agent_tui.py" "$@"
