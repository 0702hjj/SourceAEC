{
  "type": "object",
  "required": [
    "id",
    "modelId",
    "definition",
    "action",
    "phase",
    "state",
    "attempts",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^wf_[0-9a-f]{32}$"
    },
    "modelId": {
      "type": "string",
      "pattern": "^m_[0-9a-f]{16}$"
    },
    "definition": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "run",
        "save"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "geometry",
        "publication",
        "conversion"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "canceled",
        "superseded"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "string"
    },
    "result": {
      "type": "object",
      "additionalProperties": true,
      "description": "Already committed edit response, retained if conversion fails or is canceled."
    }
  }
}
