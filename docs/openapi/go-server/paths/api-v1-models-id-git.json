{
  "get": {
    "operationId": "getModelGit",
    "summary": "Read Git compatibility history",
    "description": "On-demand projection of authoritative source snapshots. Legacy Git history remains available. At most three process-local Git jobs share a 1 GiB bundle-source high-water budget; this is not an RSS or disk hard quota.",
    "tags": [
      "script"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^m_[0-9a-f]{16}$"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Success",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "code",
                "message",
                "data"
              ],
              "properties": {
                "code": {
                  "type": "integer",
                  "enum": [
                    0
                  ]
                },
                "message": {
                  "type": "string"
                },
                "data": {
                  "$ref": "#/components/schemas/GitState"
                }
              }
            }
          }
        }
      },
      "400": {
        "$ref": "#/components/responses/EditingError400"
      },
      "404": {
        "$ref": "#/components/responses/EditingError404"
      },
      "409": {
        "$ref": "#/components/responses/EditingError409"
      },
      "429": {
        "$ref": "#/components/responses/EditingError429"
      },
      "502": {
        "$ref": "#/components/responses/EditingError502"
      },
      "503": {
        "$ref": "#/components/responses/EditingError503"
      },
      "504": {
        "$ref": "#/components/responses/EditingError504"
      }
    }
  }
}
