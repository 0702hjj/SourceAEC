{
  "post": {
    "operationId": "createWorkflow",
    "summary": "Freeze and submit durable script execution",
    "tags": [
      "workflows"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^m_[0-9a-f]{16}$"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "ok",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "code",
                "message",
                "data"
              ],
              "properties": {
                "code": {
                  "type": "integer",
                  "enum": [
                    0
                  ]
                },
                "message": {
                  "type": "string"
                },
                "data": {
                  "$ref": "#/components/schemas/Workflow"
                }
              }
            }
          }
        }
      },
      "202": {
        "description": "Durably accepted",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "code",
                "message",
                "data"
              ],
              "properties": {
                "code": {
                  "type": "integer",
                  "enum": [
                    0
                  ]
                },
                "message": {
                  "type": "string"
                },
                "data": {
                  "$ref": "#/components/schemas/Workflow"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Bearer token required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "404": {
        "description": "Model or workflow not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "409": {
        "description": "Different idempotency intent, stale model or invalid state transition",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "422": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "429": {
        "description": "Capture or build capacity exhausted",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "503": {
        "description": "Frozen runtime unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "504": {
        "description": "Capture timed out",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "description": "202 only after immutable definition, blobs and run commit. Retry the same idempotency key and intent for the original run (200). Script and project inputs must still match at publication.",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/WorkflowRequest"
          }
        }
      }
    }
  },
  "get": {
    "operationId": "listWorkflows",
    "summary": "List latest workflow summaries",
    "tags": [
      "workflows"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^m_[0-9a-f]{16}$"
        }
      },
      {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    ],
    "responses": {
      "200": {
        "description": "ok",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "code",
                "message",
                "data"
              ],
              "properties": {
                "code": {
                  "type": "integer",
                  "enum": [
                    0
                  ]
                },
                "message": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "required": [
                    "workflows"
                  ],
                  "properties": {
                    "workflows": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Workflow"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Bearer token required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "404": {
        "description": "Model or workflow not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "409": {
        "description": "Different idempotency intent, stale model or invalid state transition",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "422": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "429": {
        "description": "Capture or build capacity exhausted",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "503": {
        "description": "Frozen runtime unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "504": {
        "description": "Capture timed out",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    }
  }
}
