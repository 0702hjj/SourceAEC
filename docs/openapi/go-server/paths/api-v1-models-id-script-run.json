{
  "post": {
    "summary": "沙箱运行脚本",
    "description": "Go 原生编辑：隔离运行当前暂存脚本并原子发布 IFC/DXF 产品，不创建版本。IFC 排队转换预览，DXF 使用原生 render.json。执行预算及外部解释器由管理员配置；生产环境要求 bubblewrap。",
    "operationId": "postApiV1ModelsIdScriptRun",
    "tags": [
      "script"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "模型 id",
        "schema": {
          "type": "string",
          "pattern": "^m_[0-9a-f]{16}$"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "ok",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "code",
                "message",
                "data"
              ],
              "properties": {
                "code": {
                  "type": "integer",
                  "enum": [
                    0
                  ]
                },
                "message": {
                  "type": "string",
                  "example": "ok"
                },
                "data": {
                  "$ref": "#/components/schemas/ScriptRunResult"
                }
              }
            }
          }
        }
      },
      "400": {
        "$ref": "#/components/responses/EditingError400"
      },
      "404": {
        "$ref": "#/components/responses/EditingError404"
      },
      "409": {
        "$ref": "#/components/responses/EditingError409"
      },
      "429": {
        "$ref": "#/components/responses/EditingError429"
      },
      "502": {
        "$ref": "#/components/responses/EditingError502"
      },
      "503": {
        "$ref": "#/components/responses/EditingError503"
      },
      "504": {
        "$ref": "#/components/responses/EditingError504"
      }
    },
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/SaveBody"
          }
        }
      }
    }
  }
}
