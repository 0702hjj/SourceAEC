{
  "type": "object",
  "required": [
    "id",
    "kind",
    "name",
    "status"
  ],
  "description": "项目下模型引用聚合（与 agent get_project_models 工具同形状；status 为真实状态反查，非 project.json 快照）",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^m_[0-9a-f]{16}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "ifc",
        "dxf"
      ]
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "converting",
        "ready",
        "failed"
      ]
    }
  }
}
