{
  "type": "object",
  "required": [
    "found"
  ],
  "properties": {
    "found": {
      "type": "boolean"
    },
    "designKey": {
      "type": "string"
    },
    "stale": {
      "type": "boolean",
      "description": "staging 与 map 分叉，行号不可信"
    },
    "line": {
      "type": "integer"
    },
    "col": {
      "type": "integer"
    },
    "snippet": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "argument": {
            "type": "string"
          },
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "paramPath": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        }
      }
    },
    "key": {
      "type": "string",
      "description": "DXF source-map key."
    }
  }
}
